{
  "name": "wa-ash-chat",
  "version": "0.1.0",
  "description": "ASH-ai WhatsApp chat bot — Session 1 (transport-agnostic router, Baileys, Sonnet 4.6).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "whitelist": "tsx src/admin/whitelist-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@whiskeysockets/baileys": "^6.7.18",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/qrcode-terminal": "^0.12.2",
    "drizzle-kit": "^0.30.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
