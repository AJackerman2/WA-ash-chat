# --- Required ---
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional (with defaults) ---
NODE_ENV=production
LOG_LEVEL=info

# Baileys session storage path (file-based; persists across restarts)
AUTH_DIR=./auth

# Anthropic model + rolling window
ANTHROPIC_MODEL=claude-sonnet-4-6
CONTEXT_WINDOW_SIZE=20
MAX_OUTPUT_TOKENS=1024

# Bot display name shown when registering the WhatsApp session
BOT_NAME=ASH-ai
